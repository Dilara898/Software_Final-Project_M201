# AI provider and model used in the successful demo.
# Model availability depends on your API account.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

# Add real keys only to your local .env file.
GOOGLE_API_KEY=

WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# PostgreSQL port exposed on the host by Docker Compose.
POSTGRES_HOST_PORT=5432

# Connection for Python commands running on the host.
# If POSTGRES_HOST_PORT changes, update this URL's port too.
# Docker Compose overrides the app container URL to use db:5432.
DATABASE_URL=postgresql://researcher:researcher@localhost:5432/researcher

LOG_LEVEL=INFO
CACHE_TTL_SECONDS=86400

# Per-source collection deadline; successful live setup used 30 seconds.
PER_SOURCE_TIMEOUT_SECONDS=30
MAX_SOURCES_PER_QUERY=3
